<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 模块仓库（modules.kernelsu.org）与模块图标下载；没有它 HttpURLConnection 直接抛 SecurityException -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 9 及以下把日志写进公共下载目录才需要；10+ 走 MediaStore，不申请 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Android 11+ 包可见性：超级用户列表需要读取全部已安装应用（HyperOS / MIUI 同样生效） -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!--
      HyperOS / MIUI 13+ 的「获取应用列表」权限：在 QUERY_ALL_PACKAGES 之上额外管控，
      无权限时 getInstalledPackages 只返回调用方自己。见小米开放平台《获取应用列表权限的适配说明》。
    -->
    <uses-permission android:name="com.android.permission.GET_INSTALLED_APPS" />

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.NekoSU">
        <!-- 发送日志：把 cacheDir 里的 tar.gz 以 content:// 分享出去 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          模块 WebUI 的宿主。声明 configChanges 让旋转/深浅色切换不重建 Activity，
          WebView 不会整页重载；页面内部自己响应主题 CSS 变量。
        -->
        <activity
            android:name=".ui.webui.WebUIActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode|locale|layoutDirection"
            android:exported="false"
            android:theme="@style/Theme.NekoSU" />
    </application>

</manifest>
