// SPDX-License-Identifier: GPL-3.0-or-later
// 由 CMake configure_file 生成：把 assets 二进制直接嵌入只读段。
// 相比 file(READ HEX)，.incbin 让汇编器流式拷贝字节，编译更快、内存占用更低。

    .section .rodata.ncore_assets,"a",%progbits
    .balign 8

    .global ncore_installer_sh_start
    .global ncore_installer_sh_end
    .type ncore_installer_sh_start, %object
    .type ncore_installer_sh_end, %object
ncore_installer_sh_start:
    .incbin "@INSTALLER_SH@"
ncore_installer_sh_end:

    .balign 8
    .global ncore_banner_start
    .global ncore_banner_end
    .type ncore_banner_start, %object
    .type ncore_banner_end, %object
ncore_banner_start:
    .incbin "@BANNER@"
ncore_banner_end:

    .balign 8
    .global ncore_busybox_start
    .global ncore_busybox_end
    .type ncore_busybox_start, %object
    .type ncore_busybox_end, %object
ncore_busybox_start:
    .incbin "@BUSYBOX@"
ncore_busybox_end:

    .section .note.GNU-stack,"",%progbits
